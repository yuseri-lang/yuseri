// Error values carry a hidden trace: the request id, then one file:line per Err and `?`
enum AppError { NotFound(id: Int), Invalid(field: String) }

fn find(id: Int) -> Result<Int, AppError> {
  if id == 1 { return Ok(10) }
  Err(AppError.NotFound(id: id))
}

fn load(id: Int) -> Result<Int, AppError> {
  let v = find(id)?
  Ok(v * 2)
}

fn load_twice(id: Int) -> Result<Int, AppError> {
  let v = load(id)?
  Ok(v + 1)
}

test "trace records where an error was created and propagated" {
  assert_eq(load_twice(1), Ok(21))
  match load_twice(2) {
    Ok(_) => assert(false)
    Err(e) => {
      let t = e.trace()
      assert_eq(t.len(), 4)
      assert_eq(t[0], "trace records where an error was created and propagated")
      assert(t[1].ends_with("trace.yu:6"))
      assert(t[2].ends_with("trace.yu:10"))
      assert(t[3].ends_with("trace.yu:15"))
      assert_eq(e, AppError.NotFound(id: 2))
    }
  }
}

fn wrap(e: AppError) -> Result<Int, AppError> { Err(e) }

test "a value never wrapped in Err has an empty trace" {
  let e = AppError.Invalid(field: "name")
  assert_eq(e.trace(), [])
  let r = wrap(e)
  assert_eq(r.unwrap_or(0), 0)
  match r {
    Ok(_) => assert(false)
    Err(inner) => assert_eq(inner.trace().len(), 2)
  }
}
