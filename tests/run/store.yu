// Store<T>: state that outlives a request. get copies, update replaces atomically.
import std.http

struct Counter { hits: Int, names: List<String> }

fn handle(req: Request, state: Store<Counter>) -> Response {
  state.update(fn(c: Counter) -> Counter {
    var names = c.names
    names.push(req.path)
    Counter { hits: c.hits + 1, names: names }
  })
  let now = state.get()
  http.response(200, "hit {now.hits}")
}

fn main(sys: System) -> Unit {
  let state = Store.new(Counter { hits: 0, names: [] })
  http.serve(sys.net, 8080, fn(req: Request) -> Response { handle(req, state) })
}

test "state survives across requests" {
  let state = Store.new(Counter { hits: 0, names: [] })
  assert_eq(handle(http.request("GET", "/a", ""), state).body, "hit 1")
  assert_eq(handle(http.request("GET", "/b", ""), state).body, "hit 2")
  let c = state.get()
  assert_eq(c.hits, 2)
  assert_eq(c.names, ["/a", "/b"])
}

test "get returns a copy" {
  let state = Store.new(Counter { hits: 0, names: ["x"] })
  var copy = state.get()
  copy.names.push("y")
  copy.hits = 9
  assert_eq(state.get().names, ["x"])
  assert_eq(state.get().hits, 0)
}

test "set replaces and update sees the latest value" {
  let n = Store.new(1)
  n.set(5)
  n.update(fn(v: Int) -> Int { v * 2 })
  assert_eq(n.get(), 10)
  let tags = Store.new(List<String>())
  tags.update(fn(t: List<String>) -> List<String> {
    var t2 = t
    t2.push("a")
    t2
  })
  tags.update(fn(t: List<String>) -> List<String> {
    var t2 = t
    t2.push("b")
    t2
  })
  assert_eq(tags.get(), ["a", "b"])
  assert_eq("{tags}", "Store")
}

enum StockError { Insufficient(have: Int) }

fn take(stock: Store<Int>, n: Int) -> Result<Int, StockError> {
  stock.try_update(fn(have: Int) -> Result<Int, StockError> {
    if have < n { Err(StockError.Insufficient(have: have)) } else { Ok(have - n) }
  })
}

test "update returns the new value and try_update is conditional" {
  let n = Store.new(10)
  assert_eq(n.update(fn(v: Int) -> Int { v + 5 }), 15)
  assert_eq(take(n, 4), Ok(11))
  assert_eq(take(n, 20), Err(StockError.Insufficient(have: 11)))
  assert_eq(n.get(), 11)
}

// This test is expected to fail: a panic inside update stops the request after R-STORE-01.
test "a panicking update stops the request with R-STORE-01" {
  let n = Store.new(3)
  n.update(fn(v: Int) -> Int { panic("boom {v}") })
  assert_eq(n.get(), 3)
}

enum NameError { Bad(value: String) }

test "a try_update error keeps its data after the store moves on" {
  let s = Store.new("old")
  let r = s.try_update(fn(v: String) -> Result<String, NameError> { Err(NameError.Bad(value: v)) })
  s.set("new")
  s.set("newer")
  assert_eq(r, Err(NameError.Bad(value: "old")))
  assert_eq(s.get(), "newer")
}
