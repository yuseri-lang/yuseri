// Load test server (tests/load_http.sh): a shared counter under parallel requests, and a
// handler that never returns, stopped by the deadline.
import std.http

fn handle(req: Request, hits: Store<Int>, names: Store<List<String>>, tasks: Tasks) -> Response {
  if req.path.starts_with("/names/") {
    // strings from this request's body and path must survive in the store after the request
    let name = req.path.slice(7, req.path.len())
    let all = names.update(fn(l: List<String>) -> List<String> {
      var l2 = l
      l2.push(name)
      l2
    })
    return http.response(200, "{all.len()}")
  }
  match "{req.method} {req.path}" {
    "GET /names" => http.response(200, ",".join(names.get()))
    "POST /hit" => {
      let n = hits.update(fn(v: Int) -> Int { v + 1 })
      http.response(200, "{n}")
    }
    "POST /later" => {
      // counted after the response is sent
      tasks.spawn(fn() -> Unit { hits.update(fn(v: Int) -> Int { v + 1 }) })
      http.response(202, "{hits.get()}")
    }
    "POST /later-fail" => {
      tasks.spawn(fn() -> Unit { panic("task boom") })
      http.response(202, "queued")
    }
    "GET /count" => http.response(200, "{hits.get()}")
    "GET /slow" => {
      var i = 0
      while true { i = i + 1 }
      http.response(200, "{i}")
    }
    _ => http.response(404, "not found")
  }
}

fn main(sys: System) -> Unit {
  let hits = Store.new(0)
  let names = Store.new(List<String>())
  let opts = Serve { port: 8080, deadline_ms: 500, workers: None }
  http.serve_with(sys.net, opts, fn(req: Request) -> Response { handle(req, hits, names, sys.tasks) })
}

test "hits count up" {
  let hits = Store.new(0)
  let names = Store.new(List<String>())
  let tasks = Tasks.inline()
  assert_eq(handle(http.request("POST", "/hit", ""), hits, names, tasks).body, "1")
  assert_eq(handle(http.request("POST", "/hit", ""), hits, names, tasks).body, "2")
  assert_eq(handle(http.request("GET", "/count", ""), hits, names, tasks).body, "2")
  assert_eq(handle(http.request("POST", "/later", ""), hits, names, tasks).status, 202)
  assert_eq(handle(http.request("GET", "/count", ""), hits, names, tasks).body, "3")
  assert_eq(handle(http.request("POST", "/names/ann", ""), hits, names, tasks).body, "1")
  assert_eq(handle(http.request("POST", "/names/bob", ""), hits, names, tasks).body, "2")
  assert_eq(handle(http.request("GET", "/names", ""), hits, names, tasks).body, "ann,bob")
  assert_eq(handle(http.request("GET", "/nope", ""), hits, names, tasks).status, 404)
}
