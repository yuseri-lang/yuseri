// Error ids and fix hints. Must match skills/errors.md (checked by `make check-errors`).
// X(symbol, "ID", "hint")
X(E_SYN_01, "E-SYN-01", "compare the line with the example in the named section; remove semicolons, `return` outside a function, or trailing operators")
X(E_SYN_02, "E-SYN-02", "close it on the line the hint names")
X(E_NAME_01, "E-NAME-01", "define it, `import` its module, or check the spelling")
X(E_NAME_02, "E-NAME-02", "rename one")
X(E_NAME_03, "E-NAME-03", "add `pub` in its module")
X(E_TYPE_01, "E-TYPE-01", "convert explicitly (`Int.parse`, `String.from`, ...) or change the declared type")
X(E_TYPE_02, "E-TYPE-02", "convert one side, or use interpolation / `join` for strings")
X(E_TYPE_03, "E-TYPE-03", "write `name: Type` for every parameter and `-> Type` after the list")
X(E_TYPE_04, "E-TYPE-04", "make every arm the declared type; an `if` used as a statement must not produce a value")
X(E_TYPE_05, "E-TYPE-05", "use it where a type is known, or build the value with its type (`List<Int>()`)")
X(E_TYPE_06, "E-TYPE-06", "match the signature or struct definition in the named section")
X(E_BIND_01, "E-BIND-01", "delete an unused `let` / `var`; name an unused parameter or pattern field `_`")
X(E_BIND_02, "E-BIND-02", "declare it with `var`")
X(E_BIND_03, "E-BIND-03", "pass the value as a parameter, or copy it into a `let` first")
X(E_RES_01, "E-RES-01", "add `?`, `match` it, or bind it (`let _ = expr` counts and means \"ignored on purpose\")")
X(E_RES_02, "E-RES-02", "change the return type to `Result<T, E>` so callers use `?` too; `match` with a default only when that default is correct")
X(E_MATCH_01, "E-MATCH-01", "add an arm for each listed case, or a final `_ =>` arm")
X(E_MATCH_02, "E-MATCH-02", "remove it or reorder")
X(E_STR_01, "E-STR-01", "write `\\{` or `\\}`, or use `{expr}` for interpolation")
X(E_FMT_01, "E-FMT-01", "run `yuseri fmt`")
X(R_INT_01, "R-INT-01", "check the range before the operation, or use `Float`")
X(R_INT_02, "R-INT-02", "test the divisor first and return `Err`")
X(R_LIST_01, "R-LIST-01", "use `get(i)` and handle `None`, or check `len()` first")
X(R_STR_01, "R-STR-01", "compute boundaries from `find` or `chars()`, not from arbitrary byte counts")
X(R_PANIC_01, "R-PANIC-01", "if the state is possible, return `Err` instead of `panic`")
