// First program test: arithmetic, strings, structs, enums, Option / Result, match, loops
struct User { id: Int, name: String, age: Int }

enum ValidationError { InvalidId(id: Int), EmptyName, InvalidAge(age: Int) }

fn validate(u: User) -> Result<User, ValidationError> {
  if u.id <= 0 { return Err(ValidationError.InvalidId(id: u.id)) }
  if u.name.is_empty() { return Err(ValidationError.EmptyName) }
  if u.age < 0 || u.age > 150 { return Err(ValidationError.InvalidAge(age: u.age)) }
  Ok(u)
}

fn describe(r: Result<User, ValidationError>) -> String {
  match r {
    Ok(u) if u.id > 1 => "user {u.id}"
    Ok(u) => "first user {u.name}"
    Err(ValidationError.InvalidId(id: id)) => "bad id {id}"
    Err(e) => "error: {e}"
  }
}

fn total(xs: List<Int>) -> Int {
  var sum = 0
  for x in xs {
    sum = sum + x
  }
  sum
}

fn count_words(words: List<String>) -> Map<String, Int> {
  var m = Map<String, Int>()
  for w in words {
    let n = m.get(w).unwrap_or(0)
    m.set(w, n + 1)
  }
  m
}

impl User {
  fn display(self) -> String { "{self.id}:{self.name}" }
}

test "validate accepts and rejects" {
  let ok = validate(User { id: 2, name: "Ann", age: 30 })
  assert(ok.is_ok())
  assert_eq(describe(ok), "user 2")
  assert_eq(describe(validate(User { id: 1, name: "Bo", age: 1 })), "first user Bo")
  assert_eq(describe(validate(User { id: 0, name: "Cy", age: 1 })), "bad id 0")
  assert_eq(describe(validate(User { id: 3, name: "", age: 1 })), "error: ValidationError.EmptyName")
  assert_eq(validate(User { id: 3, name: "Di", age: 151 }), Err(ValidationError.InvalidAge(age: 151)))
}

test "arithmetic and strings" {
  assert_eq(total([1, 2, 3]), 6)
  assert_eq(total([]), 0)
  assert_eq(7 / 2, 3)
  assert_eq(-7 % 3, -1)
  assert_eq("a,b,,c".split(","), ["a", "b", "", "c"])
  assert_eq(", ".join(["x", "y"]), "x, y")
  assert_eq("Hi {1 + 1}", "Hi 2")
  assert_eq(String.from(42), "42")
  assert_eq(Int.parse("12").unwrap_or(0), 12)
  assert(!Int.parse("x").is_ok())
}

test "lists, maps and methods" {
  let m = count_words(["a", "b", "a"])
  assert_eq(m.get("a"), Some(2))
  assert_eq(m.get("z"), None)
  assert_eq(m.len(), 2)
  var ks = List<String>()
  for e in m.entries() {
    ks.push("{e.key}={e.value}")
  }
  assert_eq(ks, ["a=2", "b=1"])
  let u = User { id: 9, name: "Zed", age: 40 }
  assert_eq(u.display(), "9:Zed")
  let v = User { ..u, name: "Yu" }
  assert_eq(v.display(), "9:Yu")
  let doubled = [1, 2].map(fn(x: Int) -> Int { x * 2 })
  assert_eq(doubled, [2, 4])
  let base = 10
  let shifted = [1, 2].map(fn(x: Int) -> Int { x + base })
  assert_eq(shifted, [11, 12])
  assert_eq("{[1, 2]} {Some(3)} {u}", "[1, 2] Some(3) User \{ id: 9, name: \"Zed\", age: 40 \}")
}

test "list values are copied" {
  var xs = [1]
  var ys = xs
  ys.push(2)
  assert_eq(xs.len(), 1)
  assert_eq(ys.len(), 2)
}

test "a failing test keeps the others running" {
  assert_eq(1 + 1, 3)
}

test "runtime errors have ids" {
  let zero = 0
  let _ = 1 / zero
}
