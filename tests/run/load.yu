// Load test server (tests/load_http.sh): a shared counter under parallel requests, and a
// handler that never returns, stopped by the deadline.
import std.http

fn handle(req: Request, hits: Store<Int>, tasks: Tasks) -> Response {
  match "{req.method} {req.path}" {
    "POST /hit" => {
      let n = hits.update(fn(v: Int) -> Int { v + 1 })
      http.response(200, "{n}")
    }
    "POST /later" => {
      // counted after the response is sent
      tasks.spawn(fn() -> Unit { hits.update(fn(v: Int) -> Int { v + 1 }) })
      http.response(202, "{hits.get()}")
    }
    "POST /later-fail" => {
      tasks.spawn(fn() -> Unit { panic("task boom") })
      http.response(202, "queued")
    }
    "GET /count" => http.response(200, "{hits.get()}")
    "GET /slow" => {
      var i = 0
      while true { i = i + 1 }
      http.response(200, "{i}")
    }
    _ => http.response(404, "not found")
  }
}

fn main(sys: System) -> Unit {
  let hits = Store.new(0)
  let opts = Serve { port: 8080, deadline_ms: 500, workers: None }
  http.serve_with(sys.net, opts, fn(req: Request) -> Response { handle(req, hits, sys.tasks) })
}

test "hits count up" {
  let hits = Store.new(0)
  let tasks = Tasks.inline()
  assert_eq(handle(http.request("POST", "/hit", ""), hits, tasks).body, "1")
  assert_eq(handle(http.request("POST", "/hit", ""), hits, tasks).body, "2")
  assert_eq(handle(http.request("GET", "/count", ""), hits, tasks).body, "2")
  assert_eq(handle(http.request("POST", "/later", ""), hits, tasks).status, 202)
  assert_eq(handle(http.request("GET", "/count", ""), hits, tasks).body, "3")
  assert_eq(handle(http.request("GET", "/nope", ""), hits, tasks).status, 404)
}
